diff --git a/tasks/arithmetic.py b/tasks/arithmetic.py
new file mode 100644
index 0000000..5a9b2e9
--- /dev/null
+++ b/tasks/arithmetic.py
@@ -0,0 +1,33 @@
+"""Synthetic arithmetic task with deterministic, programmatically verified answers (nanochat-50m addition; not part of upstream).
+Train/val problems are disjoint BY CONSTRUCTION: a problem (a, op, b) belongs to val iff sha1(key) % 10 == 0."""
+import hashlib, random, re
+from tasks.common import Task
+
+def _problem(rng, max_val=99):
+    op = rng.choice(["+", "-", "+", "-", "*"])
+    if op == "*": a, b = rng.randint(0, 12), rng.randint(0, 12)
+    else: a, b = rng.randint(0, max_val), rng.randint(0, max_val)
+    return a, op, b
+def _answer(a, op, b): return {"+": a + b, "-": a - b, "*": a * b}[op]
+def _is_val(a, op, b): return int(hashlib.sha1(f"{a}{op}{b}".encode()).hexdigest(), 16) % 10 == 0
+
+class ArithmeticTask(Task):
+    def __init__(self, split, num_examples=4000, max_val=99, **kwargs):
+        super().__init__(**kwargs)
+        assert split in ("train", "test"); self.split, self.n, self.max_val = split, num_examples, max_val
+    @property
+    def eval_type(self): return "generative"
+    def num_examples(self): return self.n
+    def get_example(self, index):
+        rng = random.Random(f"arith-{self.split}-{index}" + (f"-{self.max_val}" if self.max_val != 99 else ""))
+        while True:
+            a, op, b = _problem(rng, self.max_val)
+            if _is_val(a, op, b) == (self.split == "test"): break
+        q = f"What is {a} {op} {b}?"
+        return {"messages": [{"role": "user", "content": q}, {"role": "assistant", "content": str(_answer(a, op, b))}]}
+    def evaluate(self, conversation, assistant_response):
+        assert isinstance(assistant_response, str)
+        ref = conversation["messages"][-1]["content"]
+        nums = re.findall(r"-?\d+", assistant_response)
+        return int(bool(nums) and nums[-1] == ref)
+    def reward(self, conversation, assistant_response): return float(self.evaluate(conversation, assistant_response))
diff --git a/tasks/grounded_qa.py b/tasks/grounded_qa.py
new file mode 100644
index 0000000..dc6baf0
--- /dev/null
+++ b/tasks/grounded_qa.py
@@ -0,0 +1,88 @@
+"""RL task mixing (1) 2-digit arithmetic, (2) 3-digit arithmetic, (3) SQuAD-v2 grounded QA with abstention, (4) fake-entity abstention.
+nanochat-50m addition; not part of upstream. Rewards are programmatic: arithmetic = exact final number; answerable QA = gold span contained and no abstention;
+unanswerable QA / fake entity = abstains ("I don't know" etc). Train uses SQuAD v2 TRAIN; test uses SQuAD v2 VALIDATION (held out)."""
+import os, random, re
+import pyarrow.parquet as pq
+from tasks.common import Task
+from tasks.arithmetic import ArithmeticTask
+
+D = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "data", "raw", "quality")
+# same pattern as scripts/evaluate_quality.py
+ABSTAIN = re.compile(r"(?:does|do|did) not (?:mention|contain|provide|say|state|specify|include|discuss)|doesn'?t (?:mention|contain|provide|say|state|specify)|don'?t know|do not know|not (?:mentioned|stated|specified|provided|in the (?:context|text|passage))|cannot (?:be )?(?:answer|determin|find)|can'?t (?:answer|determine|find)|no information|unable to|not sure|unanswerable", re.I)
+SQ_PROMPT = "Answer the question using only the context. If the answer is not in the context, say \"I don't know.\"\n\nContext: {c}\n\nQuestion: {q}"
+FAKE_T = ["Who is the king of {x}?", "What language is spoken in {x}?", "Who discovered the {x} river?", "In what year was the {x} Empire founded?", "Where is the city of {x} located?"]
+SYL = ["ka", "lor", "vi", "men", "tha", "dru", "zel", "pho", "ran", "sul", "gur", "ibe", "nox", "fal", "ort", "wen", "yar", "cu", "mi", "bre"]
+_norm = lambda s: " ".join(re.sub(r"\b(a|an|the)\b", " ", re.sub(r"[^a-z0-9 ]", " ", s.lower())).split())
+
+class MixedRLTask(Task):
+    def __init__(self, split, num_examples=4000, **kwargs):
+        super().__init__(**kwargs)
+        assert split in ("train", "test"); self.split, self.n = split, num_examples
+        self.a2, self.a3 = ArithmeticTask(split, num_examples), ArithmeticTask(split, num_examples, max_val=999)
+        f = "squad_v2_squad_v2_train_0.parquet" if split == "train" else "squad_v2_squad_v2_validation_0.parquet"
+        rs = [r for r in pq.read_table(os.path.join(D, f)).to_pylist() if len(r["context"]) < 1100]; random.Random(5).shuffle(rs)
+        self.ans = [r for r in rs if r["answers"]["text"]]; self.una = [r for r in rs if not r["answers"]["text"]]
+    @property
+    def eval_type(self): return "generative"
+    def num_examples(self): return self.n
+    def get_example(self, index):
+        # v2 mix: 25% arithmetic (alternating 2/3-digit), 25% answerable QA, 25% unanswerable QA, 25% fake entities
+        k = index % 4; j = index // 4
+        if k == 0: c = (self.a2 if j % 2 == 0 else self.a3).get_example(j // 2); c["kind"] = "arith"; return c
+        rng = random.Random(f"fake-{self.split}-{index}")
+        if k == 1: r = self.ans[j % len(self.ans)]; return dict(kind="qa_ans", golds=r["answers"]["text"], messages=[{"role": "user", "content": SQ_PROMPT.format(c=r["context"], q=r["question"])}, {"role": "assistant", "content": r["answers"]["text"][0]}])
+        if k == 2:
+            r = self.una[j % len(self.una)]; return dict(kind="abstain", messages=[{"role": "user", "content": SQ_PROMPT.format(c=r["context"], q=r["question"])}, {"role": "assistant", "content": "I don't know."}])
+        name = "".join(rng.choice(SYL) for _ in range(rng.choice([2, 3]))).capitalize()
+        return dict(kind="abstain", messages=[{"role": "user", "content": rng.choice(FAKE_T).format(x=name)}, {"role": "assistant", "content": "I don't know."}])
+    def evaluate(self, conversation, assistant_response):
+        k = conversation["kind"]
+        if k == "arith": return self.a2.evaluate(conversation, assistant_response)
+        ab = bool(ABSTAIN.search(assistant_response))
+        if k == "abstain": return int(ab)
+        return int((not ab) and any(_norm(g) and _norm(g) in _norm(assistant_response) for g in conversation["golds"]))
+    def reward(self, conversation, assistant_response):
+        # Shaped reward (anti-collapse): the first v2 run learned to say "I don't know" to everything because abstaining on answerable questions was free.
+        k = conversation["kind"]
+        if k == "arith": return float(self.evaluate(conversation, assistant_response))
+        ab = bool(ABSTAIN.search(assistant_response)); ok = self.evaluate(conversation, assistant_response)
+        if k == "abstain": return 1.0 if ab else -0.5       # unanswerable / fake entity: abstain good, confident answer = hallucination
+        return 1.0 if ok else (-1.0 if ab else 0.0)          # answerable: correct good, over-abstaining worst, wrong answer neutral
+
+
+class ScienceRLTask(MixedRLTask):
+    """500M post-training mix (6 slots): arithmetic | grounded QA (answerable) | abstention (unanswerable + fake entities) | SciQ MC | PubMedQA yes/no/maybe | MedQA MC.
+    Rows come from the TRAIN tables only (SciQ train, PubMedQA pqa_artificial, MedQA train); the last 300 rows of each are the RL monitoring split. Final held-out numbers come from
+    scripts/evaluate_science.py on SciQ test, PubMedQA labeled and MedQA test, which this task never reads."""
+    def __init__(self, split, num_examples=6000, **kwargs):
+        super().__init__(split, num_examples, **kwargs)
+        import ast, json
+        sci = os.path.join(D, "..", "science")
+        def rows(n): return pq.read_table(os.path.join(sci, n + ".parquet")).to_pylist()
+        def cut(xs): return xs[-300:] if split == "test" else xs[:-300]               # RL monitoring split = tail of the TRAIN tables; evaluation sets are never touched
+        self.sciq = cut(rows("sciq_train")); self.pm = cut([r for r in rows("pubmedqa_artificial") if r["final_decision"] in ("yes", "no", "maybe")])
+        self.med = cut(rows("medqa_train"))
+        self._ast = ast
+    def get_example(self, index):
+        k, j = index % 6, index // 6
+        if k <= 2: c = super().get_example(j * 4 + (0, 1, 2)[k] if k < 2 else j * 4 + 2); return c   # arithmetic, answerable QA, abstention (reuse parent slots 0,1,2)
+        rng = random.Random(f"sci-{self.split}-{index}")
+        if k == 3:
+            r = self.sciq[j % len(self.sciq)]; opts = [r["correct_answer"], r["distractor1"], r["distractor2"], r["distractor3"]]; rng.shuffle(opts); gold = "ABCD"[opts.index(r["correct_answer"])]
+            q = r["question"].strip() + "\n\n" + "\n".join(f"{l}. {o}" for l, o in zip("ABCD", opts)) + "\n\nAnswer with the letter of the correct option."
+            return dict(kind="mc", gold=gold, messages=[{"role": "user", "content": q}, {"role": "assistant", "content": gold}])
+        if k == 4:
+            r = self.pm[j % len(self.pm)]; c = r["context"]; c = self._ast.literal_eval(c) if isinstance(c, str) else c
+            ctx = (" ".join(c["contexts"]) if isinstance(c, dict) else str(c))[:1800]
+            return dict(kind="yn", gold=r["final_decision"], messages=[{"role": "user", "content": f"Context: {ctx}\n\nQuestion: {r['question'].strip()}\n\nAnswer yes, no, or maybe."}, {"role": "assistant", "content": r["final_decision"]}])
+        r = self.med[j % len(self.med)]; o = r["options"]; o = self._ast.literal_eval(o) if isinstance(o, str) else o
+        q = r["question"].strip() + "\n\n" + "\n".join(f"{l}. {o[l]}" for l in "ABCD") + "\n\nAnswer with the letter of the correct option."
+        return dict(kind="mc", gold=r["answer_idx"], messages=[{"role": "user", "content": q}, {"role": "assistant", "content": r["answer_idx"]}])
+    def evaluate(self, conversation, assistant_response):
+        k = conversation["kind"]
+        if k == "mc": m = re.match(r"\s*\(?([ABCD])\b", assistant_response); return int(bool(m) and m.group(1) == conversation["gold"])
+        if k == "yn": m = re.match(r"\W*(yes|no|maybe)\b", assistant_response.lower()); return int(bool(m) and m.group(1) == conversation["gold"])
+        return super().evaluate(conversation, assistant_response)
+    def reward(self, conversation, assistant_response):
+        if conversation["kind"] in ("mc", "yn"): return float(self.evaluate(conversation, assistant_response))
+        return super().reward(conversation, assistant_response)
diff --git a/tasks/jsonl.py b/tasks/jsonl.py
new file mode 100644
index 0000000..0362e2e
--- /dev/null
+++ b/tasks/jsonl.py
@@ -0,0 +1,13 @@
+"""Task over a local JSONL file of conversations ({"messages": [...]} per line). nanochat-50m addition; not part of upstream."""
+import json
+from tasks.common import Task
+
+class JSONLTask(Task):
+    def __init__(self, path, **kwargs):
+        super().__init__(**kwargs)
+        with open(path) as f: self.rows = [json.loads(l) for l in f if l.strip()]
+        for r in self.rows: assert r["messages"][-1]["role"] == "assistant" and len(r["messages"]) % 2 == 0
+    @property
+    def eval_type(self): return "generative"
+    def num_examples(self): return len(self.rows)
+    def get_example(self, index): return {"messages": self.rows[index]["messages"]}
