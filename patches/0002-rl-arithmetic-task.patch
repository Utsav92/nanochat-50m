@@ -0,0 +1,33 @@
+"""Synthetic arithmetic task with deterministic, programmatically verified answers (nanochat-50m addition; not part of upstream).
+Train/val problems are disjoint BY CONSTRUCTION: a problem (a, op, b) belongs to val iff sha1(key) % 10 == 0."""
+import hashlib, random, re
+from tasks.common import Task
+
+def _problem(rng):
+    op = rng.choice(["+", "-", "+", "-", "*"])
+    if op == "*": a, b = rng.randint(0, 12), rng.randint(0, 12)
+    else: a, b = rng.randint(0, 99), rng.randint(0, 99)
+    return a, op, b
+def _answer(a, op, b): return {"+": a + b, "-": a - b, "*": a * b}[op]
+def _is_val(a, op, b): return int(hashlib.sha1(f"{a}{op}{b}".encode()).hexdigest(), 16) % 10 == 0
+
+class ArithmeticTask(Task):
+    def __init__(self, split, num_examples=4000, **kwargs):
+        super().__init__(**kwargs)
+        assert split in ("train", "test"); self.split, self.n = split, num_examples
+    @property
+    def eval_type(self): return "generative"
+    def num_examples(self): return self.n
+    def get_example(self, index):
+        rng = random.Random(f"arith-{self.split}-{index}")
+        while True:
+            a, op, b = _problem(rng)
+            if _is_val(a, op, b) == (self.split == "test"): break
+        q = f"What is {a} {op} {b}?"
+        return {"messages": [{"role": "user", "content": q}, {"role": "assistant", "content": str(_answer(a, op, b))}]}
+    def evaluate(self, conversation, assistant_response):
+        assert isinstance(assistant_response, str)
+        ref = conversation["messages"][-1]["content"]
+        nums = re.findall(r"-?\d+", assistant_response)
+        return int(bool(nums) and nums[-1] == ref)
+    def reward(self, conversation, assistant_response): return float(self.evaluate(conversation, assistant_response))
