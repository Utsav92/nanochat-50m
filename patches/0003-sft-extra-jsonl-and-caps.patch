diff --git a/tasks/jsonl.py b/tasks/jsonl.py
new file mode 100644
index 0000000..0362e2e
--- /dev/null
+++ b/tasks/jsonl.py
@@ -0,0 +1,13 @@
+"""Task over a local JSONL file of conversations ({"messages": [...]} per line). nanochat-50m addition; not part of upstream."""
+import json
+from tasks.common import Task
+
+class JSONLTask(Task):
+    def __init__(self, path, **kwargs):
+        super().__init__(**kwargs)
+        with open(path) as f: self.rows = [json.loads(l) for l in f if l.strip()]
+        for r in self.rows: assert r["messages"][-1]["role"] == "assistant" and len(r["messages"]) % 2 == 0
+    @property
+    def eval_type(self): return "generative"
+    def num_examples(self): return len(self.rows)
+    def get_example(self, index): return {"messages": self.rows[index]["messages"]}
